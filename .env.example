# =============================================================================
# EduBot - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)
# =============================================================================

# Server port (defaults to 8080 if not set)
PORT=8080

# Node environment
NODE_ENV=development

# PostgreSQL Database URL
# Option A: Local Docker (run: docker-compose up -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edubot

# Option B: Neon.tech free Postgres (sign up at https://neon.tech)
# DATABASE_URL=postgresql://username:password@ep-xyz.region.aws.neon.tech/edubot?sslmode=require

# Google Gemini API Key
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
